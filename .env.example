# Postgres connection used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/olo_growth_engine?schema=public"

# Redis connection used by BullMQ
REDIS_URL="redis://localhost:6379"

# Set to "mock" to use MockOloClient (default, no real Olo access needed).
# Set to "http" once a real Olo API client is implemented.
OLO_CLIENT_MODE=mock

# Placeholders for a future real Olo integration
OLO_API_BASE_URL=
OLO_API_KEY=

# Minutes an OPEN basket can go without an order before it's considered abandoned
CART_ABANDONMENT_THRESHOLD_MINUTES=30

# Messaging provider mode: "stub" logs messages instead of sending (default for dev/test)
MESSAGE_SENDER_MODE=stub
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

PORT=3000
